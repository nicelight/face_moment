TZ=Asia/Novosibirsk
# Local Python processes connect to Docker infrastructure through loopback.
DATABASE_URL=postgresql+psycopg://face_moment:face_moment_dev@127.0.0.1:55432/face_moment_local
S3_ENDPOINT_URL=http://127.0.0.1:59000
S3_ACCESS_KEY=face_moment
S3_SECRET_KEY=face_moment_dev
S3_BUCKET=face-moment-local

# Host processes cannot inspect Docker volume mountpoints directly.
POSTGRESQL_CAPACITY_VIEW_PATH=.
MINIO_CAPACITY_VIEW_PATH=.

FACE_MOMENT_TRUSTED_PROXY_IP=127.0.0.1
# Public application origin (REG.RU DNS). Compose edge reads these.
FACE_MOMENT_PUBLIC_HOST=face-moment.ru
# Deployment must replace this non-routable placeholder with the single
# FRP/Docker peer address observed by the inner Caddy; never use private_ranges.
FACE_MOMENT_FRP_PROXY_IP=192.0.2.1
# Optional backend-only fixed staff account passwords. Leave blank to keep
# existing accounts unchanged; never commit real passwords here.
STAFF_PHOTOGRAPHER_PASSWORD=
STAFF_OPERATOR_PASSWORD=
STAFF_DEVELOPER_PASSWORD=
SFACE_DETECTOR_PATH=models/opencv_sface/yunet.onnx
SFACE_RECOGNIZER_PATH=models/opencv_sface/sface.onnx
# Required for the first venue: fill from the deployed model artifacts.
# Do not use smoke-fixture/local-testing identity labels in a deployment.
SFACE_DETECTOR_ID=
SFACE_DETECTOR_VERSION=
SFACE_RECOGNIZER_ID=
SFACE_RECOGNIZER_VERSION=
SFACE_PREPROCESSING_VERSION=
SFACE_ALIGNMENT_VERSION=
SFACE_NORMALIZATION_VERSION=
SFACE_EMBEDDING_DIMENSION=
BUFFALO_DETECTOR_PATH=models/insightface_buffalo_m/scrfd.onnx
BUFFALO_RECOGNIZER_PATH=models/insightface_buffalo_m/w600k_r50.onnx

# JPEG admission: 100 MiB, 200 MP, 20000 px per side.
# Keep the edge multipart cap in deploy/Caddyfile aligned with the byte limit.
PHOTO_UPLOAD_MAX_COMPRESSED_BYTES=104857600
PHOTO_UPLOAD_MAX_DECODED_SIDE_LENGTH=20000
PHOTO_UPLOAD_MAX_DECODED_PIXELS=200000000
