[Unit]
Description=Face Moment SpaPromoClient kiosk browser
After=graphical.target

[Service]
Type=simple
User=display
Group=display
NoNewPrivileges=yes
Restart=no
ExecStart=/usr/bin/chromium --kiosk --no-first-run --no-default-browser-check --user-data-dir=/home/display/.config/face-moment/kiosk-profile https://localhost:8443/

[Install]
WantedBy=graphical.target
