https://localhost:8443 {
	tls internal

	handle /api/staff/* {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle /staff/login {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle_path /backend/* {
		reverse_proxy backend:8000
	}

	handle_path /realtime/* {
		request_body {
			max_size 20MiB
		}
		reverse_proxy realtime:8002
	}

	respond /healthz 200
}
