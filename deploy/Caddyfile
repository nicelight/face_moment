{
	servers {
		# Set to the observed FRP/Docker peer at deployment; default trusts nobody real.
		trusted_proxies static {$FACE_MOMENT_FRP_PROXY_IP:192.0.2.1}
		trusted_proxies_strict
	}
}

https://localhost:8443, https://{$FACE_MOMENT_PUBLIC_HOST:face.natureonzoom.win}:8443 {
	tls internal

	@inventory_photo_upload_without_length {
		method POST
		path /api/inventory/photos
		header !Content-Length
	}

	@inventory_photo_upload_over_cap {
		method POST
		path /api/inventory/photos
		expression `{http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > 105906176`
	}

	@realtime_attempts path /api/realtime/attempts /api/realtime/attempts/*/client-timing
	@phone_continuation path /q /phone /api/phone/*
	@backend_canonical path /api/promo/* /api/serving/display-clients /api/serving/display-clients/*/name /api/serving/spas /api/serving/spas/*/active-visit-date /api/serving/spas/*/search-dates /api/serving/spas/*/similarity-threshold /api/serving/spas/*/detector-thresholds/* /api/serving/spas/*/name /api/diagnostics/retention /api/diagnostics/people /api/diagnostics/people/* /api/diagnostics/photo-faces/* /api/diagnostics/captures /api/diagnostics/captures/* /staff/search-settings /staff/spas /staff/photo-inventory /staff/venue-media /staff/calibrations /staff/calibrations/* /staff/diagnostics-retention

	route {
		respond @inventory_photo_upload_without_length 413
		respond @inventory_photo_upload_over_cap 413

		@site_pages path /staff /site /display
		handle @site_pages {
			reverse_proxy backend:8000 {
				header_up X-Forwarded-For {client_ip}
			}
		}

		handle /api/staff/* {
			reverse_proxy backend:8000 {
				header_up X-Forwarded-For {client_ip}
			}
		}

		@advertising_admin path /staff/advertising /api/advertising/*
		handle @advertising_admin {
			request_body {
				max_size 2050MiB
			}
			reverse_proxy backend:8000 {
				header_up X-Forwarded-For {client_ip}
			}
		}

		handle /api/inventory/photos {
			request_body {
				max_size 101MiB
			}
			reverse_proxy backend:8000 {
				header_up X-Forwarded-For {client_ip}
			}
		}

		handle @realtime_attempts {
			request_body {
				max_size 20MiB
			}
			reverse_proxy realtime:8002 {
				header_up X-Forwarded-For {client_ip}
			}
		}

		handle @backend_canonical {
			reverse_proxy backend:8000 {
				header_up X-Forwarded-For {client_ip}
			}
		}

		handle @phone_continuation {
			reverse_proxy backend:8000 {
				header_up X-Forwarded-For {client_ip}
				header_up X-Forwarded-Proto {http.request.scheme}
			}
		}

		handle /api/inventory/* {
			reverse_proxy backend:8000 {
				header_up X-Forwarded-For {client_ip}
			}
		}

		handle /staff/login {
			reverse_proxy backend:8000 {
				header_up X-Forwarded-For {client_ip}
			}
		}

		@staff_diagnostics path /staff/server-events /staff/attempts /staff/attempts/*
		handle @staff_diagnostics {
			reverse_proxy backend:8000 {
				header_up X-Forwarded-For {client_ip}
			}
		}

		handle /staff/photo-upload {
			reverse_proxy backend:8000 {
				header_up X-Forwarded-For {client_ip}
			}
		}

		handle /staff/processing-health {
			reverse_proxy backend:8000 {
				header_up X-Forwarded-For {client_ip}
			}
		}

		handle /staff/display-clients {
			reverse_proxy backend:8000 {
				header_up X-Forwarded-For {client_ip}
			}
		}

		handle /client/* {
			reverse_proxy backend:8000 {
				header_up X-Forwarded-For {client_ip}
			}
		}

		handle / {
			reverse_proxy backend:8000 {
				header_up X-Forwarded-For {client_ip}
			}
		}

		handle_path /backend/* {
			reverse_proxy backend:8000 {
				header_up X-Forwarded-For {client_ip}
			}
		}

		handle_path /realtime/* {
			request_body {
				max_size 20MiB
			}
			reverse_proxy realtime:8002 {
				header_up X-Forwarded-For {client_ip}
			}
		}

		respond /healthz 200
	}
}
