{$FACE_MOMENT_PUBLIC_HOST:face.natureonzoom.win}, {$FACE_MOMENT_FRP_HOST:face-time.moment-studio.ru} {
	@frp path /~!frp

	handle @frp {
		reverse_proxy 127.0.0.1:7000
	}

	handle {
		reverse_proxy https://127.0.0.1:18443 {
			# Preserve public origin; internal TLS SNI is independent of HTTP Host.
			header_up Host {hostport}
			# This is the first public proxy (Cloudflare DNS-only).
			header_up X-Forwarded-For {remote_host}

			transport http {
				tls_server_name localhost
				tls_insecure_skip_verify
			}
		}
	}
}
